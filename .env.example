# Copie para .env e ajuste antes de subir em produção.
# docker compose lê estas variáveis automaticamente.

POSTGRES_DB=elo
POSTGRES_USER=elo
POSTGRES_PASSWORD=troque-esta-senha

# Segredo JWT com pelo menos 32 caracteres. Nunca use o valor de desenvolvimento.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-32+

# Conta administradora criada no primeiro start
ADMIN_EMAIL=carolfreitasmuniz@alu.ufc.br
ADMIN_NOME=Carol Freitas Muniz
ADMIN_PASSWORD=troque-esta-senha-admin

# Origem do frontend (CORS) e links dos e-mails
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# SMTP opcional — sem isso o pedido de acesso fica no painel /admin
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cdigital NEPEC <noreply@localhost>

# Ambiente da API: Development | Production
ASPNETCORE_ENVIRONMENT=Production
